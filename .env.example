# Copy to .env.local for local dev. For production, add these as GitHub repo variables (Settings > Secrets and variables > Actions > Variables).
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
# Optional. Defaults to <origin>/strong/. Spotify does not accept "localhost"; use 127.0.0.1 for local dev.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/strong/
